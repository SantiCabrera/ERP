        function autoCalculateVencimiento() {
            const provId = parseInt(document.getElementById("fp-proveedor").value);
            const p = proveedores.find(x => x.id === provId);
            const emisionVal = document.getElementById("fp-emision").value;

            if (p && emisionVal) {
                const dias = p.condicionDias || 0;
                const parts = emisionVal.split("-");
                const d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, parseInt(parts[2]));
                d.setDate(d.getDate() + dias);
                document.getElementById("fp-vencimiento").value = d.toISOString().split("T")[0];
            }
        }

