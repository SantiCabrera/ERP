        function handleCobroClienteSubmit(e) {
            e.preventDefault();

            const facId = parseInt(document.getElementById("cobro-fac-id").value);
            const f = facturas.find(x => x.id === facId);
            if (!f) return;

            const montoACobrarMO = parseFloat(document.getElementById("cobro-monto-mo").value) || 0;
            const fechaCobro = document.getElementById("cobro-fecha").value;
            const cuentaBancoCodigo = document.getElementById("cobro-cuenta-fondos").value;

            if (montoACobrarMO <= 0) {
                alert("Ingrese un monto válido a cobrar.");
                return;
            }

            const totalMO = f.totalCobrarMO || f.totalMO;
            const cobradoAnterior = f.montoCobradoMO || 0;
            const nuevoCobradoTotal = cobradoAnterior + montoACobrarMO;

            if (nuevoCobradoTotal > totalMO + 0.01) {
                alert(`El monto ingresado excede el saldo pendiente. Saldo máximo a cobrar: ${f.monedaOriginal} ${(totalMO - cobradoAnterior).toFixed(2)}`);
                return;
            }

            f.montoCobradoMO = nuevoCobradoTotal;
            f.estadoCobro = nuevoCobradoTotal >= (totalMO - 0.01) ? "COBRADO" : "PARCIAL";

            const tcUSD = f.tc || 1.0;
            const montoACobrarUSD = montoACobrarMO * tcUSD;

            // Registrar Asiento Contable del Ingreso a Banco (Caja/Banco DB vs Deudores HB)
            const newAsientoId = asientos.length > 0 ? Math.max(...asientos.map(a => a.id)) + 1 : 1;
            asientos.push({
                id: newAsientoId,
                facId: f.id,
                empresa: f.empresaEmisora,
                fecha: fechaCobro,
                concepto: `Cobro Factura N° ${f.numeroFactura} - ${f.razonSocial}`,
                moneda: "USD",
                tc: 1.0,
                detalles: [
                    { cuenta: cuentaBancoCodigo, debe: montoACobrarUSD, haber: 0 },
                    { cuenta: "1.1.2.01", debe: 0, haber: montoACobrarUSD }
                ]
            });

            saveState();
            closeModalCobroCliente();
            renderAll();
            alert(`🎉 Cobro registrado exitosamente para la factura N° ${f.numeroFactura}.`);
        }

