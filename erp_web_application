            filtered.forEach(cxp => {
                const tr = document.createElement("tr");
                const isPend = cxp.estado === "PENDIENTE";
                const isVencida = isPend && (cxp.fechaVencimiento < today);

                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-mono text-xs text-slate-600">${cxp.fechaEmision}</td>
                    <td class="py-2.5 px-3 font-mono text-xs font-semibold ${isVencida ? 'text-rose-600' : 'text-slate-800'}">${cxp.fechaVencimiento}</td>
                    <td class="py-2.5 px-3 font-semibold text-slate-800">${cxp.facturaNumero}</td>
                    <td class="py-2.5 px-3">
                        <div class="text-slate-800 font-medium">${cxp.proveedor}</div>
                        <div class="text-xs text-slate-400 font-normal">${cxp.concepto || '-'}</div>
                    </td>
                    <td class="py-2.5 px-3 text-xs font-bold text-brand-700">${cxp.empresaFacturada}</td>
                    <td class="py-2.5 px-3 text-right font-mono text-xs text-slate-600">${cxp.moneda} ${cxp.netoMO.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-mono text-xs text-slate-600">${cxp.moneda} ${cxp.ivaMO.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-mono font-bold">${cxp.moneda} ${cxp.montoOrigen.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-mono font-bold text-slate-900">$ ${cxp.montoUSD.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-center">
                        <span class="text-xs font-semibold px-2 py-0.5 rounded-full ${!isPend ? 'bg-emerald-100 text-emerald-800' : (isVencida ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800')}">
                            ${!isPend ? 'PAGADO' : (isVencida ? 'VENCIDA' : 'PENDIENTE')}
