        function calculateAsientoTotals() {
            let totalDebe = 0, totalHaber = 0;
            document.querySelectorAll(".asiento-row").forEach(row => {
                totalDebe += parseFloat(row.querySelector(".line-debe").value) || 0;
                totalHaber += parseFloat(row.querySelector(".line-haber").value) || 0;
            });

            const diff = Math.abs(totalDebe - totalHaber);
            document.getElementById("asiento-total-debe").textContent = `$ ${totalDebe.toFixed(2)}`;
            document.getElementById("asiento-total-haber").textContent = `$ ${totalHaber.toFixed(2)}`;
            document.getElementById("asiento-diferencia").textContent = `$ ${diff.toFixed(2)}`;

            const badge = document.getElementById("asiento-status-badge");
            if (diff < 0.01 && totalDebe > 0) {
                badge.textContent = "Partida Doble Ok";
                badge.className = "text-xs font-semibold px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-800";
            } else {
                badge.textContent = "Desbalanceado";
                badge.className = "text-xs font-semibold px-2.5 py-1 rounded-full bg-rose-100 text-rose-800";
            }
        }

        function saveAsientoManual() {
            const empresa = document.getElementById("asiento-empresa").value;
            const fecha = document.getElementById("asiento-fecha").value;
            const concepto = document.getElementById("asiento-concepto").value;
            const moneda = document.getElementById("asiento-moneda").value;
            const tc = parseFloat(document.getElementById("asiento-tc").value) || 1.0;

            if (!concepto) { alert("Ingrese el concepto."); return; }

            let detalles = [];
            let totalDebe = 0, totalHaber = 0;

            document.querySelectorAll(".asiento-row").forEach(row => {
                const cuenta = row.querySelector(".line-cuenta").value;
                const debe = (parseFloat(row.querySelector(".line-debe").value) || 0) * tc;
                const haber = (parseFloat(row.querySelector(".line-haber").value) || 0) * tc;

                if (cuenta && (debe > 0 || haber > 0)) {
                    detalles.push({ cuenta, debe, haber });
                    totalDebe += debe; totalHaber += haber;
                }
            });

            if (Math.abs(totalDebe - totalHaber) > 0.01 || totalDebe === 0) {
                alert("Asiento desbalanceado o vacío.");
                return;
            }

            const newId = asientos.length > 0 ? Math.max(...asientos.map(a => a.id)) + 1 : 1;
            asientos.push({ id: newId, empresa, fecha, concepto, moneda, tc, detalles });

            saveState();
            renderAll();
            alert(`🎉 Asiento N° ${newId} guardado con éxito.`);
            document.getElementById("asiento-concepto").value = "";
            initAsientoManualForm();
        }

        // LIBRO DIARIO
        function renderLibroDiario() {
            const tbody = document.getElementById('libro-diario-tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const startDate = document.getElementById('filter-start-date')?.value;
            const endDate = document.getElementById('filter-end-date')?.value;
            const accountFilter = document.getElementById('filter-account')?.value;

            let filteredAsientos = state.asientos;

            if (startDate) {
                filteredAsientos = filteredAsientos.filter(a => a.fecha >= startDate);
            }
            if (endDate) {
                filteredAsientos = filteredAsientos.filter(a => a.fecha <= endDate);
            }
            if (accountFilter) {
                filteredAsientos = filteredAsientos.filter(a => 
                    a.lineas.some(l => l.cuentaId === accountFilter)
                );
            }

            let totalDebe = 0;
            let totalHaber = 0;

            if (filteredAsientos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="px-6 py-8 text-center text-slate-400">No se encontraron asientos contables registrados.</td></tr>`;
                document.getElementById('ld-total-debe').textContent = '$0.00';
                document.getElementById('ld-total-haber').textContent = '$0.00';
                return;
            }

            filteredAsientos.forEach(asiento => {
                asiento.lineas.forEach((linea, index) => {
                    totalDebe += linea.debe || 0;
                    totalHaber += linea.haber || 0;

                    const row = document.createElement('tr');
                    row.className = "hover:bg-slate-700/30 transition-colors border-b border-slate-700/50";
                    
                    const cuenta = state.planCuentas.find(c => c.id === linea.cuentaId);
                    const cuentaNombre = cuenta ? `${cuenta.codigo} - ${cuenta.nombre}` : linea.cuentaId;

                    row.innerHTML = `
                        <td class="px-6 py-3 font-mono text-xs text-slate-400">${index === 0 ? asiento.num : ''}</td>
                        <td class="px-6 py-3 whitespace-nowrap text-xs text-slate-300">${index === 0 ? asiento.fecha : ''}</td>
                        <td class="px-6 py-3 font-medium text-slate-200">${cuentaNombre}</td>
                        <td class="px-6 py-3 text-slate-400 text-xs">${index === 0 ? asiento.concepto : ''}</td>
                        <td class="px-6 py-3 text-right font-mono text-emerald-400">${linea.debe ? formatCurrency(linea.debe) : '-'}</td>
                        <td class="px-6 py-3 text-right font-mono text-rose-400">${linea.haber ? formatCurrency(linea.haber) : '-'}</td>
                    `;
                    tbody.appendChild(row);
                });
            });

            const elTotalDebe = document.getElementById('ld-total-debe');
            const elTotalHaber = document.getElementById('ld-total-haber');
            if (elTotalDebe) elTotalDebe.textContent = formatCurrency(totalDebe);
            if (elTotalHaber) elTotalHaber.textContent = formatCurrency(totalHaber);
        }

        function renderBalanceSaldos() {
            const tbody = document.getElementById('balance-saldos-tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            const saldos = {};

            // Initialize balances for all accounts
            state.planCuentas.forEach(c => {
                saldos[c.id] = { codigo: c.codigo, nombre: c.nombre, tipo: c.tipo, debe: 0, haber: 0 };
            });

            // Accumulate entries
            state.asientos.forEach(asiento => {
                asiento.lineas.forEach(linea => {
                    if (saldos[linea.cuentaId]) {
                        saldos[linea.cuentaId].debe += linea.debe || 0;
                        saldos[linea.cuentaId].haber += linea.haber || 0;
                    }
                });
            });

            let sumSumasDebe = 0;
            let sumSumasHaber = 0;
            let sumSaldosDeudor = 0;
            let sumSaldosAcreedor = 0;

            Object.values(saldos).forEach(item => {
                if (item.debe === 0 && item.haber === 0) return; // Skip inactive accounts

                const saldoDeudor = item.debe > item.haber ? item.debe - item.haber : 0;
                const saldoAcreedor = item.haber > item.debe ? item.haber - item.debe : 0;

                sumSumasDebe += item.debe;
                sumSumasHaber += item.haber;
                sumSaldosDeudor += saldoDeudor;
                sumSaldosAcreedor += saldoAcreedor;

                const row = document.createElement('tr');
                row.className = "hover:bg-slate-700/30 transition-colors border-b border-slate-700/50";
                row.innerHTML = `
                    <td class="px-6 py-3 font-mono text-xs text-slate-400">${item.codigo}</td>
                    <td class="px-6 py-3 font-medium text-slate-200">${item.nombre}</td>
                    <td class="px-6 py-3 text-right font-mono text-slate-300">${formatCurrency(item.debe)}</td>
                    <td class="px-6 py-3 text-right font-mono text-slate-300">${formatCurrency(item.haber)}</td>
                    <td class="px-6 py-3 text-right font-mono text-emerald-400">${formatCurrency(saldoDeudor)}</td>
                    <td class="px-6 py-3 text-right font-mono text-rose-400">${formatCurrency(saldoAcreedor)}</td>
                `;
                tbody.appendChild(row);
            });

            document.getElementById('bs-sum-debe').textContent = formatCurrency(sumSumasDebe);
            document.getElementById('bs-sum-haber').textContent = formatCurrency(sumSumasHaber);
            document.getElementById('bs-saldo-deudor').textContent = formatCurrency(sumSaldosDeudor);
            document.getElementById('bs-saldo-acreedor').textContent = formatCurrency(sumSaldosAcreedor);
        }

        function renderPlanCuentas() {
            const tbody = document.getElementById('plan-cuentas-tbody');
            if (!tbody) return;
            tbody.innerHTML = '';

            // Sort by account code
            const sorted = [...state.planCuentas].sort((a, b) => a.codigo.localeCompare(b.codigo));

            sorted.forEach(cuenta => {
                const row = document.createElement('tr');
                row.className = "hover:bg-slate-700/30 transition-colors border-b border-slate-700/50";
                
                const isNivel1 = cuenta.codigo.split('.').length === 1;

                row.innerHTML = `
                    <td class="px-6 py-3 font-mono text-sm ${isNivel1 ? 'font-bold text-sky-400' : 'text-slate-300'}">${cuenta.codigo}</td>
                    <td class="px-6 py-3 ${isNivel1 ? 'font-bold text-white' : 'text-slate-200'}">${cuenta.nombre}</td>
                    <td class="px-6 py-3 text-xs uppercase text-slate-400">${cuenta.tipo}</td>
                    <td class="px-6 py-3 text-right">
                        <button onclick="deleteCuenta('${cuenta.id}')" class="text-xs px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded transition-colors">Eliminar</button>
                    </td>
                `;
                tbody.appendChild(row);
            });

            updateAccountSelects();
        }

        function updateAccountSelects() {
            const selects = document.querySelectorAll('.account-select');
            selects.forEach(select => {
                const currentVal = select.value;
                select.innerHTML = '<option value="">-- Seleccionar Cuenta --</option>';
                state.planCuentas.forEach(cuenta => {
                    const opt = document.createElement('option');
                    opt.value = cuenta.id;
                    opt.textContent = `${cuenta.codigo} - ${cuenta.nombre}`;
                    select.appendChild(opt);
                });
                if (currentVal) select.value = currentVal;
            });
        }

        function formatCurrency(val) {
            return new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' }).format(val || 0);
        }

        function showNotification(message, type = 'success') {
            const notif = document.createElement('div');
            notif.className = `fixed bottom-5 right-5 px-5 py-3 rounded-xl shadow-2xl text-white font-medium text-sm transition-all duration-300 transform translate-y-2 opacity-0 z-50 flex items-center gap-2 ${
                type === 'danger' ? 'bg-rose-600' : type === 'warning' ? 'bg-amber-600' : 'bg-emerald-600'
            }`;
            notif.innerHTML = `<span>${message}</span>`;
            document.body.appendChild(notif);

            setTimeout(() => {
                notif.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                notif.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => notif.remove(), 300);
            }, 3000);
        }

        function saveAsientoManual() {
            const fecha = document.getElementById('asiento-fecha').value;
            const concepto = document.getElementById('asiento-concepto').value;
            const rows = document.querySelectorAll('#asiento-lines-body tr');

            if (!fecha || !concepto) {
                showNotification('Por favor complete la fecha y el concepto del asiento.', 'warning');
                return;
            }

            const lineas = [];
            let totalDebe = 0;
            let totalHaber = 0;

            rows.forEach(row => {
                const cuentaId = row.querySelector('.account-select')?.value;
                const debe = parseFloat(row.querySelector('.debe-input')?.value) || 0;
                const haber = parseFloat(row.querySelector('.haber-input')?.value) || 0;

                if (cuentaId && (debe > 0 || haber > 0)) {
                    lineas.push({ cuentaId, debe, haber });
                    totalDebe += debe;
                    totalHaber += haber;
                }
            });

            if (lineas.length < 2) {
                showNotification('Un asiento contable requiere al menos 2 líneas con montos válidos.', 'warning');
                return;
            }

            if (Math.abs(totalDebe - totalHaber) > 0.01) {
                showNotification(`El asiento no cuadra. Debe: ${formatCurrency(totalDebe)}, Haber: ${formatCurrency(totalHaber)}.`, 'danger');
                return;
            }

            const nuevoAsiento = {
                id: 'AS-' + Date.now(),
                num: state.asientos.length + 1,
                fecha,
                concepto,
                lineas
            };

            state.asientos.push(nuevoAsiento);
            showNotification('Asiento contable guardado exitosamente.');
            
            // Reset form
            document.getElementById('asiento-concepto').value = '';
            renderLibroDiario();
            renderBalanceSaldos();
        }

        function saveNuevaCuenta() {
            const codigo = document.getElementById('nueva-cuenta-codigo').value.trim();
            const nombre = document.getElementById('nueva-cuenta-nombre').value.trim();
            const tipo = document.getElementById('nueva-cuenta-tipo').value;

            if (!codigo || !nombre || !tipo) {
                showNotification('Complete todos los campos de la cuenta.', 'warning');
                return;
            }

            if (state.planCuentas.some(c => c.codigo === codigo)) {
                showNotification('Ya existe una cuenta contable con este código.', 'danger');
                return;
            }

            state.planCuentas.push({ id: 'ACC-' + Date.now(), codigo, nombre, tipo });
            showNotification('Cuenta agregada al Plan de Cuentas.');

            document.getElementById('nueva-cuenta-codigo').value = '';
            document.getElementById('nueva-cuenta-nombre').value = '';
            
            renderPlanCuentas();
        }

        function deleteCuenta(id) {
            const estaEnUso = state.asientos.some(a => a.lineas.some(l => l.cuentaId === id));
            if (estaEnUso) {
                showNotification('No se puede eliminar una cuenta que posee movimientos contables registrados.', 'danger');
                return;
            }

            state.planCuentas = state.planCuentas.filter(c => c.id !== id);
            showNotification('Cuenta eliminada.');
            renderPlanCuentas();
        }

        function exportLibroDiarioCSV() {
            let csv = 'Asiento,Fecha,Cuenta,Concepto,Debe,Haber\n';
            state.asientos.forEach(a => {
                a.lineas.forEach(l => {
                    const c = state.planCuentas.find(pc => pc.id === l.cuentaId);
                    const cuentaNombre = c ? `"${c.codigo} - ${c.nombre}"` : l.cuentaId;
                    csv += `${a.num},${a.fecha},${cuentaNombre},"${a.concepto}",${l.debe || 0},${l.haber || 0}\n`;
                });
            });

            downloadCSV(csv, 'Libro_Diario.csv');
        }

        function exportBalanceSaldosCSV() {
            let csv = 'Codigo,Cuenta,Debe,Haber,Saldo Deudor,Saldo Acreedor\n';
            renderBalanceSaldos(); // Refresh calculation
            
            const saldos = {};
            state.planCuentas.forEach(c => saldos[c.id] = { codigo: c.codigo, nombre: c.nombre, debe: 0, haber: 0 });
            state.asientos.forEach(a => {
                a.lineas.forEach(l => {
                    if (saldos[l.cuentaId]) {
                        saldos[l.cuentaId].debe += l.debe || 0;
                        saldos[l.cuentaId].haber += l.haber || 0;
                    }
                });
            });

            Object.values(saldos).forEach(item => {
                if (item.debe === 0 && item.haber === 0) return;
                const saldoDeudor = item.debe > item.haber ? item.debe - item.haber : 0;
                const saldoAcreedor = item.haber > item.debe ? item.haber - item.debe : 0;
                csv += `"${item.codigo}","${item.nombre}",${item.debe},${item.haber},${saldoDeudor},${saldoAcreedor}\n`;
            });

            downloadCSV(csv, 'Balance_de_Saldos.csv');
        }

        function downloadCSV(csv, filename) {
            const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', filename);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        window.onload = function() {
            // Set current date for inputs
            const today = new Date().toISOString().split('T')[0];
            const fechaInput = document.getElementById('asiento-fecha');
            if (fechaInput) fechaInput.value = today;

            // Initial render calls
            renderPlanCuentas();
            renderLibroDiario();
            renderBalanceSaldos();
        };
    </script>
</body>
