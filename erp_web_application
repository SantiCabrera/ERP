            const f = facturas.find(x => x.id === facId);
            if (!f) return;

            const cobradoMO = f.montoCobradoMO || 0;
            const totalMO = f.totalCobrarMO || f.totalMO;
            const saldoMO = totalMO - cobradoMO;

            document.getElementById("cobro-fac-id").value = f.id;
            document.getElementById("cobro-lbl-cliente").textContent = `${f.razonSocial} (${f.empresaEmisora})`;
            document.getElementById("cobro-lbl-factura").textContent = f.numeroFactura;
            document.getElementById("cobro-lbl-total").textContent = `${f.monedaOriginal} ${totalMO.toLocaleString("en-US", {minimumFractionDigits: 2})}`;
