        function calcFacAvanzada() {
            const aFacturarMO = parseFloat(document.getElementById("fac-afacturar-mo").value) || 0;
            const ivaMO = parseFloat(document.getElementById("fac-iva-mo").value) || 0;
            const totalMO = aFacturarMO + ivaMO;
            document.getElementById("fac-total-mo").value = totalMO.toFixed(2);

            const pctCom = parseFloat(document.getElementById("fac-pct-com").value) || 0;
            const descuentaCom = document.getElementById("fac-descuenta-com").checked;

            const comisionMO = aFacturarMO * (pctCom / 100);
            const ivaCMO = comisionMO * 0.22;
            const totalComisionMO = comisionMO + ivaCMO;

            let vendidoMO = aFacturarMO;
            let totalCobrarMO = totalMO;

            if (descuentaCom) {
                vendidoMO = aFacturarMO - comisionMO;
                totalCobrarMO = totalMO - totalComisionMO;
            }

            document.getElementById("fac-comision-mo").value = comisionMO.toFixed(2);
            document.getElementById("fac-ivac-mo").value = ivaCMO.toFixed(2);
            document.getElementById("fac-totalcom-mo").value = totalComisionMO.toFixed(2);
            document.getElementById("fac-vendido-mo").value = vendidoMO.toFixed(2);
            document.getElementById("fac-totalcobrar-mo").value = totalCobrarMO.toFixed(2);

            const tcUSD = parseFloat(document.getElementById("fac-tc").value) || 1.0;

            const aFacturarUSD = aFacturarMO * tcUSD;
            const ivaUSD = ivaMO * tcUSD;
            const totalUSD = totalMO * tcUSD;
            const comisionUSD = comisionMO * tcUSD;
            const ivaCUSD = ivaCMO * tcUSD;
            const totalComisionUSD = totalComisionMO * tcUSD;
            const vendidoUSD = vendidoMO * tcUSD;
            const totalCobrarUSD = totalCobrarMO * tcUSD;

            document.getElementById("fac-afacturar-usd").value = `USD $ ${aFacturarUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-iva-usd").value = `USD $ ${ivaUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-total-usd").value = `USD $ ${totalUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-comision-usd").value = `USD $ ${comisionUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-ivac-usd").value = `USD $ ${ivaCUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-totalcom-usd").value = `USD $ ${totalComisionUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-vendido-usd").value = `USD $ ${vendidoUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("fac-totalcobrar-usd").value = `USD $ ${totalCobrarUSD.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
        }

