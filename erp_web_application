        // CASH FLOW / FLUJO DE CAJA
        function renderCashFlow() {
            const tbody = document.getElementById("tbody-cashflow");
            if (!tbody) return;
            tbody.innerHTML = "";

            const tipoPeriodo = document.getElementById("cf-periodo-tipo") ? document.getElementById("cf-periodo-tipo").value : "mes";
            
            const cobrosPendientes = facturas.filter(f => f.estadoCobro !== "COBRADO" && (selectedCompanyFilter === "ALL" || f.empresaEmisora === selectedCompanyFilter));
            const pagosPendientes = cuentasPorPagar.filter(cxp => cxp.estado === "PENDIENTE" && (selectedCompanyFilter === "ALL" || cxp.empresaFacturada === selectedCompanyFilter));

            let totalCobros = 0;
            let totalPagos = 0;

            const mapaPeriodos = {};

            function getClavePeriodo(fechaStr) {
                if (!fechaStr) return "Sin Fecha";
                if (tipoPeriodo === "mes") {
                    return fechaStr.substring(0, 7);
                } else {
                    const d = new Date(fechaStr + "T00:00:00");
                    const firstJan = new Date(d.getFullYear(), 0, 1);
                    const numSemana = Math.ceil((((d - firstJan) / 86400000) + firstJan.getDay() + 1) / 7);
                    return `${d.getFullYear()}-W${numSemana < 10 ? '0' + numSemana : numSemana}`;
                }
            }

            cobrosPendientes.forEach(f => {
                const key = getClavePeriodo(f.vencimiento);
                if (!mapaPeriodos[key]) mapaPeriodos[key] = { cobros: 0, pagos: 0 };
                const saldoCobrarMO = f.totalCobrarMO - (f.montoCobradoMO || 0);
                const saldoCobrarUSD = saldoCobrarMO * (f.tc || 1.0);
                mapaPeriodos[key].cobros += saldoCobrarUSD;
                totalCobros += saldoCobrarUSD;
            });

            pagosPendientes.forEach(cxp => {
                const key = getClavePeriodo(cxp.fechaVencimiento);
                if (!mapaPeriodos[key]) mapaPeriodos[key] = { cobros: 0, pagos: 0 };
                mapaPeriodos[key].pagos += cxp.montoUSD;
                totalPagos += cxp.montoUSD;
            });

            const netoTotal = totalCobros - totalPagos;
            document.getElementById("cf-kpi-ingresos").textContent = `$ ${totalCobros.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            document.getElementById("cf-kpi-egresos").textContent = `$ ${totalPagos.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            
            const kpiNetoEl = document.getElementById("cf-kpi-neto");
            const kpiStatusEl = document.getElementById("cf-kpi-status");
            kpiNetoEl.textContent = `$ ${netoTotal.toLocaleString("en-US", {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            
            if (netoTotal >= 0) {
                kpiStatusEl.textContent = "Superávit Proyectado";
                kpiStatusEl.className = "text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 inline-block mt-1";
            } else {
                kpiStatusEl.textContent = "Déficit Proyectado";
                kpiStatusEl.className = "text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-800 inline-block mt-1";
            }

            const periodosOrdenados = Object.keys(mapaPeriodos).sort();

            if (periodosOrdenados.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-slate-400 font-sans">No hay movimientos futuros o vencimientos programados.</td></tr>`;
                renderCashFlowChart([], [], []);
                return;
            }

            let saldoAcumulado = 0;
            const chartLabels = [];
            const chartIngresos = [];
            const chartEgresos = [];

            periodosOrdenados.forEach(per => {
                const datos = mapaPeriodos[per];
                const netoPeriodo = datos.cobros - datos.pagos;
                saldoAcumulado += netoPeriodo;

                chartLabels.push(per);
                chartIngresos.push(datos.cobros);
                chartEgresos.push(datos.pagos);

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="py-2.5 px-3 font-bold text-slate-800">${per}</td>
                    <td class="py-2.5 px-3 text-right font-semibold text-emerald-600">$ ${datos.cobros.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-semibold text-rose-600">$ ${datos.pagos.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-bold ${netoPeriodo >= 0 ? 'text-emerald-700' : 'text-rose-700'}">$ ${netoPeriodo.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-extrabold text-slate-900 bg-slate-50">$ ${saldoAcumulado.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                `;
                tbody.appendChild(tr);
            });

            renderCashFlowChart(chartLabels, chartIngresos, chartEgresos);
        }

