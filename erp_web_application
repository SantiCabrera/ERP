<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>369.ad - ERP Regional Multientidad & Multimoneda</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                            900: '#0c4a6e',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

    <!-- HEADER / NAVBAR -->
    <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col md:flex-row md:items-center justify-between gap-3">
            <div class="flex items-center space-x-3">
                <div class="bg-brand-500 text-white p-2 rounded-lg font-bold text-xl tracking-wider">369</div>
                <div>
                    <h1 class="font-bold text-lg leading-none">369.ad ERP Regional</h1>
                    <span class="text-xs text-slate-400">Consolidación Multientidad (USD / UYU / ARS / PYG / MXN / PEN)</span>
                </div>
            </div>

            <!-- SELECTOR GLOBAL DE EMPRESA & PIZARRA DE TIPOS DE CAMBIO -->
            <div class="flex flex-wrap items-center gap-2 text-xs">
                <!-- Filtro Empresa Global -->
                <div class="bg-brand-900 border border-brand-700 px-2.5 py-1 rounded flex items-center space-x-1.5">
                    <span class="text-slate-300 font-semibold">Empresa:</span>
                    <select id="global-company-filter" onchange="onGlobalCompanyChange()" class="bg-slate-900 text-brand-300 font-bold px-1 py-0.5 rounded border border-brand-700 focus:outline-none">
                        <option value="ALL" selected>🌐 Toda la Corporación (Consolidado USD)</option>
                        <option value="Indato Digital SRL">Indato Digital SRL (Uruguay)</option>
                        <option value="Alfage SAS">Alfage SAS (Holding Uruguay)</option>
                        <option value="La Castellana SRL">La Castellana SRL (Paraguay)</option>
                        <option value="369 Argentina SRL">369 Argentina SRL (Argentina)</option>
                        <option value="Indato México">Indato (México)</option>
                        <option value="Indato Perú">Indato (Perú)</option>
                    </select>
                </div>

                <!-- TCs -->
                <div class="bg-slate-800 px-2 py-1 rounded border border-slate-700 flex items-center space-x-1">
                    <span class="text-slate-400 font-semibold">USD/UYU:</span>
                    <input type="number" id="tc-usd" value="40.00" step="0.10" onchange="updateGlobalTCs()" class="w-12 bg-slate-900 text-brand-400 font-bold px-1 rounded border border-slate-700 focus:outline-none text-right">
                </div>
                <div class="bg-slate-800 px-2 py-1 rounded border border-slate-700 flex items-center space-x-1">
                    <span class="text-slate-400 font-semibold">ARS/USD:</span>
                    <input type="number" id="tc-ars" value="1250" step="10" onchange="updateGlobalTCs()" class="w-14 bg-slate-900 text-brand-400 font-bold px-1 rounded border border-slate-700 focus:outline-none text-right">
                </div>
                <div class="bg-slate-800 px-2 py-1 rounded border border-slate-700 flex items-center space-x-1">
                    <span class="text-slate-400 font-semibold">PYG/USD:</span>
                    <input type="number" id="tc-pyg" value="7800" step="50" onchange="updateGlobalTCs()" class="w-16 bg-slate-900 text-brand-400 font-bold px-1 rounded border border-slate-700 focus:outline-none text-right">
                </div>
                <div class="bg-slate-800 px-2 py-1 rounded border border-slate-700 flex items-center space-x-1">
                    <span class="text-slate-400 font-semibold">MXN/USD:</span>
                    <input type="number" id="tc-mxn" value="19.50" step="0.1" onchange="updateGlobalTCs()" class="w-12 bg-slate-900 text-brand-400 font-bold px-1 rounded border border-slate-700 focus:outline-none text-right">
                </div>
                <div class="bg-slate-800 px-2 py-1 rounded border border-slate-700 flex items-center space-x-1">
                    <span class="text-slate-400 font-semibold">PEN/USD:</span>
                    <input type="number" id="tc-pen" value="3.75" step="0.01" onchange="updateGlobalTCs()" class="w-12 bg-slate-900 text-brand-400 font-bold px-1 rounded border border-slate-700 focus:outline-none text-right">
                </div>

                <button onclick="fetchLiveExchangeRates()" class="bg-brand-600 hover:bg-brand-700 text-white px-2 py-1 rounded text-xs font-semibold flex items-center space-x-1 transition shadow-sm" title="Actualizar cotizaciones en vivo vía API">
                    <i data-lucide="refresh-cw" class="w-3.5 h-3.5"></i>
                    <span>Auto TCs</span>
                </button>

                <button onclick="resetDemoData()" class="text-slate-400 hover:text-rose-400 transition flex items-center space-x-1 ml-1" title="Restablecer Datos Demo">
                    <i data-lucide="rotate-ccw" class="w-4 h-4"></i>
                </button>
            </div>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full flex flex-col md:flex-row gap-6">

        <!-- SIDEBAR NAVIGATION -->
        <aside class="w-full md:w-64 bg-white p-4 rounded-xl border border-slate-200 shadow-sm shrink-0 self-start">
            <nav class="space-y-1">
                <button onclick="switchTab('dashboard')" id="nav-dashboard" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-brand-600 bg-brand-50 transition">
                    <i data-lucide="layout-dashboard" class="w-5 h-5"></i>
                    <span>Dashboard Corporativo</span>
                </button>
                <button onclick="switchTab('cashflow')" id="nav-cashflow" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="line-chart" class="w-5 h-5"></i>
                    <span>Flujo de Caja (Cash Flow)</span>
                </button>
                <button onclick="switchTab('facturas-lista')" id="nav-facturas-lista" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition relative">
                    <i data-lucide="folder-kanban" class="w-5 h-5"></i>
                    <span>Facturas Emitidas</span>
                    <span id="badge-cxc-count" class="ml-auto bg-emerald-100 text-emerald-800 text-xs font-semibold px-2 py-0.5 rounded-full hidden">0</span>
                </button>
                <button onclick="switchTab('facturacion')" id="nav-facturacion" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="file-plus" class="w-5 h-5"></i>
                    <span>Nueva Factura Cliente</span>
                </button>
                <button onclick="switchTab('proveedores')" id="nav-proveedores" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="users" class="w-5 h-5"></i>
                    <span>Proveedores</span>
                </button>
                <button onclick="switchTab('cuentas-pagar')" id="nav-cuentas-pagar" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition relative">
                    <i data-lucide="receipt" class="w-5 h-5"></i>
                    <span>Cuentas por Pagar</span>
                    <span id="badge-cxp-count" class="ml-auto bg-amber-100 text-amber-800 text-xs font-semibold px-2 py-0.5 rounded-full hidden">0</span>
                </button>
                <button onclick="switchTab('asientos')" id="nav-asientos" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="pen-tool" class="w-5 h-5"></i>
                    <span>Nuevo Asiento</span>
                </button>
                <button onclick="switchTab('diario')" id="nav-diario" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="book-open" class="w-5 h-5"></i>
                    <span>Libro Diario</span>
                </button>
                <button onclick="switchTab('balance')" id="nav-balance" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="scale" class="w-5 h-5"></i>
                    <span>Balance de Saldos</span>
                </button>
                <button onclick="switchTab('plan-cuentas')" id="nav-plan-cuentas" class="nav-btn w-full flex items-center space-x-3 px-3 py-2.5 text-sm font-medium rounded-lg text-slate-600 hover:bg-slate-50 hover:text-slate-900 transition">
                    <i data-lucide="folder-tree" class="w-5 h-5"></i>
                    <span>Plan de Cuentas</span>
                </button>
            </nav>
        </aside>

        <!-- MAIN CONTENT CONTAINER -->
        <main class="flex-1 space-y-6">

            <!-- TAB 1: DASHBOARD -->
            <section id="tab-dashboard" class="tab-content space-y-6">
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ventas Netas (USD)</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span id="kpi-ventas" class="text-2xl font-extrabold text-slate-900">$ 0.00</span>
                            <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">+Consolidado</span>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Compras Netas (USD)</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span id="kpi-compras" class="text-2xl font-extrabold text-slate-900">$ 0.00</span>
                            <span class="text-xs font-semibold text-slate-600 bg-slate-100 px-2 py-0.5 rounded-full">Costos</span>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Pasivos Pendientes (USD)</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span id="stat-cxp-pending" class="text-2xl font-extrabold text-amber-600">$ 0.00</span>
                            <span id="kpi-iva-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-amber-50 text-amber-800">CxP Global</span>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Resultado Consolidado</span>
                        <div class="mt-2 flex items-baseline justify-between">
                            <span id="kpi-resultado" class="text-2xl font-extrabold text-slate-900">$ 0.00</span>
                            <span id="kpi-resultado-badge" class="text-xs font-semibold px-2 py-0.5 rounded-full">---</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm lg:col-span-2">
                        <h3 class="font-bold text-slate-800 text-base mb-4">Márgenes y Consolidación por Unidad de Negocio</h3>
                        <div class="h-64">
                            <canvas id="chart-resultados"></canvas>
                        </div>
                    </div>
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col justify-between">
                        <div>
                            <h3 class="font-bold text-slate-800 text-base mb-2">Entidades del Grupo</h3>
                            <p class="text-xs text-slate-500 mb-3">Saldos operativos por razón social y país.</p>
                            <div class="space-y-2 text-xs">
                                <div class="flex justify-between py-1.5 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Indato Digital SRL (UY):</span>
                                    <span class="font-bold text-slate-900">USD / UYU</span>
                                </div>
                                <div class="flex justify-between py-1.5 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Alfage SAS (Holding UY):</span>
                                    <span class="font-bold text-slate-900">USD / UYU</span>
                                </div>
                                <div class="flex justify-between py-1.5 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">La Castellana SRL (PY):</span>
                                    <span class="font-bold text-slate-900">USD / PYG</span>
                                </div>
                                <div class="flex justify-between py-1.5 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">369 Argentina SRL (AR):</span>
                                    <span class="font-bold text-slate-900">USD / ARS</span>
                                </div>
                                <div class="flex justify-between py-1.5 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Indato (México):</span>
                                    <span class="font-bold text-slate-900">USD / MXN</span>
                                </div>
                                <div class="flex justify-between py-1.5 border-b border-slate-100">
                                    <span class="text-slate-600 font-medium">Indato (Perú):</span>
                                    <span class="font-bold text-slate-900">USD / PEN</span>
                                </div>
                            </div>
                        </div>
                        <button onclick="switchTab('facturacion')" class="w-full mt-4 bg-brand-600 text-white font-medium py-2 px-4 rounded-lg hover:bg-brand-700 transition text-sm flex items-center justify-center space-x-2">
                            <i data-lucide="file-plus" class="w-4 h-4"></i>
                            <span>Emitir Facturación</span>
                        </button>
                    </div>
                </div>
            </section>

            <!-- TAB: CASH FLOW / FLUJO DE CAJA -->
            <section id="tab-cashflow" class="tab-content space-y-6 hidden">
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-6">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-slate-100 pb-4 gap-2">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Proyección de Flujo de Caja (Cash Flow)</h2>
                            <p class="text-xs text-slate-500">Estimación de liquidez consolidada (USD) considerando cobros esperados y pagos pendientes.</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="text-xs text-slate-500 font-semibold">Agrupar por:</span>
                            <select id="cf-periodo-tipo" onchange="renderCashFlow()" class="border border-slate-300 rounded-lg p-1.5 text-xs bg-slate-50 font-bold">
                                <option value="mes">Mensual</option>
                                <option value="semana">Semanal</option>
                            </select>
                        </div>
                    </div>

                    <!-- KPIs CASH FLOW -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div class="bg-emerald-50/50 border border-emerald-200 p-4 rounded-xl">
                            <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block">Cobros Proyectados (USD)</span>
                            <span id="cf-kpi-ingresos" class="text-2xl font-extrabold text-emerald-700 mt-1 block">$ 0.00</span>
                            <span class="text-[10px] text-emerald-600 font-medium">Facturas a Clientes pendientes de cobrar</span>
                        </div>
                        <div class="bg-rose-50/50 border border-rose-200 p-4 rounded-xl">
                            <span class="text-xs font-bold text-rose-800 uppercase tracking-wider block">Pagos Proyectados (USD)</span>
                            <span id="cf-kpi-egresos" class="text-2xl font-extrabold text-rose-700 mt-1 block">$ 0.00</span>
                            <span class="text-[10px] text-rose-600 font-medium">Facturas de Proveedores pendientes de pago</span>
                        </div>
                        <div class="bg-brand-50/50 border border-brand-200 p-4 rounded-xl">
                            <span class="text-xs font-bold text-brand-800 uppercase tracking-wider block">Flujo Neto Estimado (USD)</span>
                            <span id="cf-kpi-neto" class="text-2xl font-extrabold text-brand-900 mt-1 block">$ 0.00</span>
                            <span id="cf-kpi-status" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-brand-100 text-brand-800 inline-block mt-1">Superávit Proyectado</span>
                        </div>
                    </div>

                    <!-- GRÁFICO FLUJO DE CAJA -->
                    <div class="bg-slate-50 p-4 rounded-xl border border-slate-200">
                        <h3 class="font-bold text-slate-800 text-sm mb-3">Evolución Semanal / Mensual del Flujo de Caja</h3>
                        <div class="h-64">
                            <canvas id="chart-cashflow"></canvas>
                        </div>
                    </div>

                    <!-- TABLA DETALLADA POR PERÍODOS -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-y border-slate-200">
                                <tr>
                                    <th class="py-3 px-3">Período Vencimiento</th>
                                    <th class="py-3 px-3 text-right text-emerald-700">Entradas / Cobros (USD)</th>
                                    <th class="py-3 px-3 text-right text-rose-700">Salidas / Pagos (USD)</th>
                                    <th class="py-3 px-3 text-right">Flujo Neto del Período</th>
                                    <th class="py-3 px-3 text-right font-bold">Saldo Acumulado Proyectado</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-cashflow" class="divide-y divide-slate-100 font-mono text-xs">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

            <!-- TAB: FACTURAS EMITIDAS A CLIENTES (NUEVA SECCIÓN COMPLETA) -->
            <section id="tab-facturas-lista" class="tab-content space-y-6 hidden">
                <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-sm space-y-4">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center border-b border-slate-100 pb-4 gap-2">
                        <div>
                            <h2 class="text-lg font-bold text-slate-900">Gestión de Facturas Emitidas a Clientes</h2>
                            <p class="text-xs text-slate-500">Administra los cobros totales o parciales, edita datos de facturas y realiza el seguimiento contable.</p>
                        </div>
                        <button onclick="switchTab('facturacion')" class="bg-brand-600 hover:bg-brand-700 text-white px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1 shadow-sm">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                            <span>Emitir Nueva Factura</span>
                        </button>
                    </div>

                    <!-- FILTROS Y BÚSQUEDA DE FACTURAS -->
                    <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 text-xs space-y-3">
                        <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-4 gap-3">
                            <div>
                                <label class="block text-slate-500 font-semibold mb-1">Buscar Cliente / Factura N°:</label>
                                <input type="text" id="cxc-search-text" oninput="renderFacturasEmitidasTab()" placeholder="Buscar cliente, N° factura, campaña..." class="w-full border border-slate-300 rounded p-1.5 bg-white">
                            </div>
                            <div>
                                <label class="block text-slate-500 font-semibold mb-1">Estado del Cobro:</label>
                                <select id="cxc-filter-estado" onchange="renderFacturasEmitidasTab()" class="w-full border border-slate-300 rounded p-1.5 bg-white font-medium">
                                    <option value="TODOS">Todos los Estados</option>
                                    <option value="PENDIENTE">Solo Pendientes</option>
                                    <option value="PARCIAL">Solo Cobro Parcial</option>
                                    <option value="COBRADO">Solo Cobrados Totalmente</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-slate-500 font-semibold mb-1">Empresa Emisora:</label>
                                <select id="cxc-filter-empresa" onchange="renderFacturasEmitidasTab()" class="w-full border border-slate-300 rounded p-1.5 bg-white font-medium">
                                    <option value="TODOS">Todas las Empresas</option>
                                    <option value="Indato Digital SRL">Indato Digital SRL (UY)</option>
                                    <option value="Alfage SAS">Alfage SAS (Holding UY)</option>
                                    <option value="La Castellana SRL">La Castellana SRL (PY)</option>
                                    <option value="369 Argentina SRL">369 Argentina SRL (AR)</option>
                                    <option value="Indato México">Indato (México)</option>
                                    <option value="Indato Perú">Indato (Perú)</option>
                                </select>
                            </div>
                            <div class="flex items-end">
                                <button onclick="resetCxCFilters()" class="text-slate-500 hover:text-slate-800 underline text-xs pb-2">Limpiar Filtros</button>
                            </div>
                        </div>
                    </div>

                    <!-- TABLA PRINCIPAL DE FACTURAS EMITIDAS -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead class="bg-slate-50 text-slate-500 text-xs uppercase font-semibold border-y border-slate-200">
                                <tr>
                                    <th class="py-3 px-3">Emisión / Venc.</th>
                                    <th class="py-3 px-3">Empresa / N° Factura</th>
                                    <th class="py-3 px-3">Cliente / Detalle</th>
                                    <th class="py-3 px-3 text-right">Total MO</th>
                                    <th class="py-3 px-3 text-right">Total USD</th>
                                    <th class="py-3 px-3 text-right">Cobrado (MO)</th>
                                    <th class="py-3 px-3 text-right">Saldo Pend. (MO)</th>
                                    <th class="py-3 px-3 text-center">Estado</th>
                                    <th class="py-3 px-3 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-facturas-emitidas" class="divide-y divide-slate-100 font-mono text-xs">
                                <!-- Dynamic -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </section>

