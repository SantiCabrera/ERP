        async function fetchLiveExchangeRates(isSilent = false) {
            try {
                const response = await fetch("https://open.er-api.com/v6/latest/USD");
                const data = await response.json();

                if (data && data.rates) {
                    globalTCs.UYU = data.rates.UYU || globalTCs.UYU;
                    globalTCs.ARS = data.rates.ARS || globalTCs.ARS;
                    globalTCs.PYG = data.rates.PYG || globalTCs.PYG;
                    globalTCs.MXN = data.rates.MXN || globalTCs.MXN;
                    globalTCs.PEN = data.rates.PEN || globalTCs.PEN;

                    document.getElementById("tc-usd").value = globalTCs.UYU.toFixed(2);
                    document.getElementById("tc-ars").value = globalTCs.ARS.toFixed(2);
                    document.getElementById("tc-pyg").value = Math.round(globalTCs.PYG);
                    document.getElementById("tc-mxn").value = globalTCs.MXN.toFixed(2);
                    document.getElementById("tc-pen").value = globalTCs.PEN.toFixed(2);

                    saveState();
                    renderAll();

                    if (!isSilent) alert("✅ Tipos de cambio actualizados en vivo.");
                }
            } catch (error) {
                console.error("Error al actualizar los tipos de cambio:", error);
