        // NUEVO MÓDULO: GESTIÓN DE FACTURAS EMITIDAS A CLIENTES (PAGO, EDICIÓN, BORRADO)
        function renderFacturasEmitidasTab() {
            const tbody = document.getElementById("tbody-facturas-emitidas");
            if (!tbody) return;
            tbody.innerHTML = "";

            const searchText = document.getElementById("cxc-search-text") ? document.getElementById("cxc-search-text").value.toLowerCase().trim() : "";
            const filterEstado = document.getElementById("cxc-filter-estado") ? document.getElementById("cxc-filter-estado").value : "TODOS";
            const filterEmpresa = document.getElementById("cxc-filter-empresa") ? document.getElementById("cxc-filter-empresa").value : "TODOS";

            const filtered = facturas.filter(f => {
                const matchGlobal = (selectedCompanyFilter === "ALL" || f.empresaEmisora === selectedCompanyFilter);
                const matchEmpresa = (filterEmpresa === "TODOS" || f.empresaEmisora === filterEmpresa);
                
                const estado = f.estadoCobro || "PENDIENTE";
                const matchEstado = (filterEstado === "TODOS" || estado === filterEstado);

                let matchText = true;
                if (searchText) {
                    matchText = f.razonSocial.toLowerCase().includes(searchText) ||
                                f.numeroFactura.toLowerCase().includes(searchText) ||
                                (f.campanas && f.campanas.toLowerCase().includes(searchText)) ||
                                (f.marca && f.marca.toLowerCase().includes(searchText));
                }

                return matchGlobal && matchEmpresa && matchEstado && matchText;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="py-6 text-center text-slate-400 font-sans text-xs">No hay facturas emitidas que coincidan con los filtros.</td></tr>`;
                return;
            }

            filtered.sort((a,b) => b.id - a.id).forEach(f => {
                const cobradoMO = f.montoCobradoMO || 0;
                const totalMO = f.totalCobrarMO || f.totalMO;
                const saldoMO = totalMO - cobradoMO;
                const estado = f.estadoCobro || (cobradoMO >= totalMO ? "COBRADO" : (cobradoMO > 0 ? "PARCIAL" : "PENDIENTE"));

                let badgeClass = "bg-amber-100 text-amber-800";
                if (estado === "COBRADO") badgeClass = "bg-emerald-100 text-emerald-800";
                if (estado === "PARCIAL") badgeClass = "bg-blue-100 text-blue-800";

                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="py-2.5 px-3">
                        <div class="font-bold text-slate-800">${f.emision}</div>
                        <div class="text-[10px] text-slate-400">Venc: ${f.vencimiento}</div>
                    </td>
                    <td class="py-2.5 px-3">
                        <div class="font-bold text-brand-800">${f.numeroFactura}</div>
                        <div class="text-[10px] text-slate-500">${f.empresaEmisora}</div>
                    </td>
                    <td class="py-2.5 px-3">
                        <div class="font-bold text-slate-900">${f.razonSocial}</div>
                        <div class="text-[10px] text-slate-400">${f.campanas || f.producto || '-'}</div>
                    </td>
                    <td class="py-2.5 px-3 text-right font-bold text-slate-800">${f.monedaOriginal} ${totalMO.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-extrabold text-slate-900">$ ${f.totalUSD.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-semibold text-emerald-600">${f.monedaOriginal} ${cobradoMO.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-right font-bold text-brand-700">${f.monedaOriginal} ${saldoMO.toLocaleString("en-US", {minimumFractionDigits: 2})}</td>
                    <td class="py-2.5 px-3 text-center">
                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full ${badgeClass}">${estado}</span>
                    </td>
                    <td class="py-2.5 px-3 text-center">
                        <div class="flex items-center justify-center space-x-1">
                            ${estado !== "COBRADO" ? `
                                <button onclick="openModalCobroCliente(${f.id})" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold px-2 py-1 rounded shadow-sm flex items-center space-x-1" title="Registrar Cobro">
