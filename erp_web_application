        function calcFacturaProvTax(mode = 'total') {
            const tasaStr = document.getElementById("fp-tasa-impuesto").value;
            let pct = 0;
            if (tasaStr === "22") pct = 0.22;
            else if (tasaStr === "10" || tasaStr === "10_py") pct = 0.10;
            else if (tasaStr === "21") pct = 0.21;
            else if (tasaStr === "16_mx") pct = 0.16;
            else if (tasaStr === "18_pe") pct = 0.18;

            let total = parseFloat(document.getElementById("fp-monto").value) || 0;
            let neto = parseFloat(document.getElementById("fp-neto-mo").value) || 0;
            let iva = parseFloat(document.getElementById("fp-iva-mo").value) || 0;

            if (mode === 'total') {
                neto = total / (1 + pct);
                iva = total - neto;
                document.getElementById("fp-neto-mo").value = neto.toFixed(2);
                document.getElementById("fp-iva-mo").value = iva.toFixed(2);
            } else if (mode === 'neto') {
                iva = neto * pct;
                total = neto + iva;
                document.getElementById("fp-iva-mo").value = iva.toFixed(2);
                document.getElementById("fp-monto").value = total.toFixed(2);
            }
        }

        function handleFacturaProvSubmit(e) {
            e.preventDefault();

            const editingId = document.getElementById("fp-editing-id").value;
            const provId = parseInt(document.getElementById("fp-proveedor").value);
            const p = proveedores.find(x => x.id === provId);
            if (!p) return;

            const facturaNumero = document.getElementById("fp-numero").value.trim();
            const conceptoInput = document.getElementById("fp-concepto").value.trim();
            const conceptoFinal = conceptoInput || `Compra Factura Prov. N° ${facturaNumero} - ${p.razonSocial}`;

            const fechaEmision = document.getElementById("fp-emision").value;
            const fechaVencimiento = document.getElementById("fp-vencimiento").value;
            const cuentaGastoCodigo = document.getElementById("fp-cuenta-gasto").value;
            const tasaImpuesto = document.getElementById("fp-tasa-impuesto").value;
            const moneda = document.getElementById("fp-moneda").value;
            
            const netoMO = parseFloat(document.getElementById("fp-neto-mo").value) || 0;
            const ivaMO = parseFloat(document.getElementById("fp-iva-mo").value) || 0;
            const montoOrigen = parseFloat(document.getElementById("fp-monto").value) || (netoMO + ivaMO);
            const tc = parseFloat(document.getElementById("fp-tc").value) || 1.0;

            const montoUSD = montoOrigen * tc;
            const netoUSD = netoMO * tc;
            const ivaUSD = ivaMO * tc;

            const detalles = [
                { cuenta: cuentaGastoCodigo, debe: netoUSD, haber: 0 },
                { cuenta: "2.1.1.01", debe: 0, haber: montoUSD }
            ];
            if (ivaUSD > 0) detalles.push({ cuenta: "1.1.3.01", debe: ivaUSD, haber: 0 });

            if (editingId) {
                const cxpId = parseInt(editingId);
                const cxp = cuentasPorPagar.find(x => x.id === cxpId);
                if (cxp) {
                    cxp.proveedorId = p.id;
                    cxp.proveedor = p.razonSocial;
                    cxp.concepto = conceptoFinal;
                    cxp.paisProveedor = p.pais;
                    cxp.empresaFacturada = p.empresaFactura;
                    cxp.facturaNumero = facturaNumero;
                    cxp.fechaEmision = fechaEmision;
                    cxp.fechaVencimiento = fechaVencimiento;
                    cxp.cuentaGasto = cuentaGastoCodigo;
                    cxp.tasaImpuesto = tasaImpuesto;
                    cxp.moneda = moneda;
                    cxp.netoMO = netoMO;
                    cxp.ivaMO = ivaMO;
                    cxp.montoOrigen = montoOrigen;
                    cxp.montoUSD = montoUSD;
                }

                const aIdx = asientos.findIndex(a => a.cxpId === cxpId);
                if (aIdx !== -1) {
                    asientos[aIdx].empresa = p.empresaFactura;
                    asientos[aIdx].fecha = fechaEmision;
                    asientos[aIdx].concepto = conceptoFinal;
                    asientos[aIdx].detalles = detalles;
                }

                alert(`✅ Factura N° ${facturaNumero} actualizada correctamente.`);
            } else {
                const newCxpId = cuentasPorPagar.length > 0 ? Math.max(...cuentasPorPagar.map(x => x.id)) + 1 : 1;

                cuentasPorPagar.push({
                    id: newCxpId,
                    proveedorId: p.id,
                    proveedor: p.razonSocial,
                    concepto: conceptoFinal,
                    paisProveedor: p.pais,
                    empresaFacturada: p.empresaFactura,
                    facturaNumero, fechaEmision, fechaVencimiento,
                    cuentaGasto: cuentaGastoCodigo, tasaImpuesto, moneda,
                    netoMO, ivaMO, montoOrigen, montoUSD,
                    estado: "PENDIENTE"
                });

                const newAsientoId = asientos.length > 0 ? Math.max(...asientos.map(a => a.id)) + 1 : 1;

                asientos.push({
                    id: newAsientoId,
                    cxpId: newCxpId,
                    empresa: p.empresaFactura,
                    fecha: fechaEmision,
                    concepto: conceptoFinal,
                    moneda: "USD",
                    tc: 1.0,
                    detalles
                });

                alert(`🎉 Factura N° ${facturaNumero} registrada.`);
            }

            saveState();
            renderAll();
            cancelFacturaProvForm();
        }

