        function renderCuentasPorPagar() {
            const tbody = document.getElementById("tbody-cxp");
            const filterStatus = document.getElementById("cxp-filter-status").value;
            const filterEmpresa = document.getElementById("cxp-filter-empresa").value;
            const emisionDesde = document.getElementById("cxp-filter-emision-desde").value;
            const emisionHasta = document.getElementById("cxp-filter-emision-hasta").value;
            const vencDesde = document.getElementById("cxp-filter-venc-desde").value;
            const vencHasta = document.getElementById("cxp-filter-venc-hasta").value;

            const filterNumFact = document.getElementById("cxp-filter-numfact") ? document.getElementById("cxp-filter-numfact").value.toLowerCase().trim() : "";
            const filterProveedor = document.getElementById("cxp-filter-proveedor") ? document.getElementById("cxp-filter-proveedor").value.toLowerCase().trim() : "";
            const filterMoneda = document.getElementById("cxp-filter-moneda") ? document.getElementById("cxp-filter-moneda").value : "TODOS";
            const filterMontoMin = parseFloat(document.getElementById("cxp-filter-monto-min").value) || null;
            const filterMontoMax = parseFloat(document.getElementById("cxp-filter-monto-max").value) || null;

            tbody.innerHTML = "";
            const today = new Date().toISOString().split("T")[0];

            const filtered = cuentasPorPagar.filter(x => {
                const matchGlobal = (selectedCompanyFilter === "ALL" || x.empresaFacturada === selectedCompanyFilter);
                const matchEmpresa = (filterEmpresa === "TODOS" || x.empresaFacturada === filterEmpresa);
                const matchStatus = (filterStatus === "TODOS" || x.estado === filterStatus);

                if (filterNumFact && !x.facturaNumero.toLowerCase().includes(filterNumFact)) return false;
                if (filterProveedor && !x.proveedor.toLowerCase().includes(filterProveedor)) return false;
                if (filterMoneda !== "TODOS" && x.moneda !== filterMoneda) return false;
                if (filterMontoMin !== null && x.montoOrigen < filterMontoMin) return false;
                if (filterMontoMax !== null && x.montoOrigen > filterMontoMax) return false;

                let matchFecha = true;
                if (emisionDesde && x.fechaEmision < emisionDesde) matchFecha = false;
                if (emisionHasta && x.fechaEmision > emisionHasta) matchFecha = false;
                if (vencDesde && x.fechaVencimiento < vencDesde) matchFecha = false;
                if (vencHasta && x.fechaVencimiento > vencHasta) matchFecha = false;

                return matchGlobal && matchEmpresa && matchStatus && matchFecha;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="11" class="py-4 text-center text-slate-400 text-xs">Sin registros que coincidan con los filtros aplicados.</td></tr>`;
                return;
