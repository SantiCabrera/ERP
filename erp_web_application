                    <td class="py-2.5 px-3 text-center">
                        <div class="flex items-center justify-center space-x-1">
                            ${isPend ? `<button onclick="openModalPago(${cxp.id})" class="bg-brand-600 hover:bg-brand-700 text-white text-xs font-medium px-2 py-0.5 rounded shadow-sm" title="Registrar Pago">Pagar</button>` : ''}
